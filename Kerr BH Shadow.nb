Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "functions"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[Xi]", "[", 
      RowBox[{"r_", ",", "a_", ",", "M_"}], "]"}], ":=", 
     FractionBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "^", "2"}], " ", "M"}], "+", 
        RowBox[{
         RowBox[{"a", "^", "2"}], " ", "r"}], "-", 
        RowBox[{"3", " ", "M", " ", 
         RowBox[{"r", "^", "2"}]}], "+", 
        RowBox[{"r", "^", "3"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{"a", " ", 
        RowBox[{"(", 
         RowBox[{"M", "-", "r"}], ")"}]}], ")"}]]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Eta]", "[", 
      RowBox[{"r_", ",", "a_", ",", "M_"}], "]"}], ":=", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", "^", "3"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "4"}], " ", 
            RowBox[{"a", "^", "2"}], " ", "M"}], "+", 
           RowBox[{"9", " ", 
            RowBox[{"M", "^", "2"}], " ", "r"}], "-", 
           RowBox[{"6", " ", "M", " ", 
            RowBox[{"r", "^", "2"}]}], "+", 
           RowBox[{"r", "^", "3"}]}], ")"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"M", "-", "r"}], ")"}], "2"]}], ")"}]]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Alpha]", "[", 
      RowBox[{"r_", ",", "a_", ",", "M_", ",", "theta_"}], "]"}], ":=", 
     FractionBox[
      RowBox[{"-", 
       RowBox[{"\[Xi]", "[", 
        RowBox[{"r", ",", "a", ",", "M"}], "]"}]}], 
      RowBox[{"Sin", "[", "theta", "]"}]]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Beta]", "[", 
      RowBox[{"r_", ",", "a_", ",", "M_", ",", "\[Theta]_"}], "]"}], ":=", 
     SqrtBox[
      RowBox[{
       RowBox[{"\[Eta]", "[", 
        RowBox[{"r", ",", "a", ",", "M"}], "]"}], "+", 
       RowBox[{
        SuperscriptBox["a", "2"], 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "-", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"\[Xi]", "[", 
          RowBox[{"r", ",", "a", ",", "M"}], "]"}], "2"], " ", 
        SuperscriptBox[
         RowBox[{"Cot", "[", "\[Theta]", "]"}], "2"]}]}]]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9519857587429466`*^9, 3.951985832811306*^9}, 
